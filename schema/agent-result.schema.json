{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Result returned by the agent",
  "type": "object",
  "required": [
    "status"
  ],
  "properties": {
    "status": {
      "enum": [
        "completed",
        "blocked",
        "failed"
      ]
    },
    "claimed_stage": {
      "enum": [
        "product",
        "cart",
        "checkout",
        "shipping",
        "payment"
      ]
    },
    "reported_total": {
      "type": "object",
      "required": [
        "amount"
      ],
      "properties": {
        "amount": {
          "type": "number"
        },
        "currency": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "final_url": {
      "type": "string"
    },
    "evidence": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "failure": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        }
      }
    },
    "steps": {
      "type": "number"
    },
    "cost_usd": {
      "type": "number"
    }
  }
}
